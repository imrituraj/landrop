# LanDrop configuration. Copy to .env and adjust. Every value is optional unless noted.
# Invalid values stop the server at startup with a readable error.

# --- Network -----------------------------------------------------------------
# Interface to bind. 127.0.0.1 (default) = this machine only. 0.0.0.0 = all interfaces (LAN).
HOST=0.0.0.0
PORT=8787
# docker compose only (required there): LAN IP or hostname devices will open, e.g. 192.168.1.20
LANDROP_HOSTNAME=192.168.1.20

# --- Origins -----------------------------------------------------------------
# Exact origins allowed to open the signaling WebSocket (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://192.168.1.20:8443
# Also allow an Origin that matches the request Host header. Set false when ALLOWED_ORIGINS is complete.
ALLOW_SAME_ORIGIN=true
# Origin to put in invitation links (useful when the host itself opens LanDrop via localhost).
PUBLIC_ORIGIN=https://192.168.1.20:8443
# Trust X-Forwarded-For from a reverse proxy for per-IP limits. Only enable behind your proxy.
TRUST_PROXY=false

# --- Static files and logging -------------------------------------------------
# Directory containing the built web app (pnpm build -> apps/web/dist). Empty = API/WebSocket only.
# Relative paths resolve against the directory the server is started from (repo root for `pnpm start`).
# Leave unset for `pnpm dev` (Vite serves the app). Docker sets this itself.
# STATIC_DIR=apps/web/dist
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Rooms and sessions -------------------------------------------------------
ROOM_TTL_SECONDS=86400
ROOM_RETENTION_SECONDS=300
ROOM_MAX_PEERS=8
ROOM_CODE_TTL_SECONDS=600
JOIN_REQUEST_TTL_SECONDS=90
SESSION_RESUME_GRACE_SECONDS=45

# --- Resource limits ------------------------------------------------------------
MAX_ROOMS=500
MAX_CLIENTS=1000
MAX_CLIENTS_PER_IP=20
HEARTBEAT_INTERVAL_MS=15000
INIT_TIMEOUT_MS=10000
SHUTDOWN_GRACE_MS=3000

# --- Rate limits (bucket capacity; refills over one minute / second) ------------
RATE_JOIN_PER_MIN=10
RATE_CODE_JOIN_PER_MIN=5
RATE_CODE_FAIL_GLOBAL_PER_MIN=60
RATE_ROOM_CREATE_PER_MIN=10
RATE_CONNECT_PER_MIN=60
RATE_MESSAGES_PER_SEC=50
RATE_MESSAGES_BURST=200
